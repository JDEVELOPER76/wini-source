# time.exp - Módulo de tiempo para Wini

# ===== FUNCIONES =====

# Obtener tiempo actual como diccionario
func ahora() -> diccionario
# Retorna: {year: entero, month: entero, day: entero, hour: entero, minute: entero, second: entero, weekday: entero, yearday: entero, timestamp: entero}

# Dormir por milisegundos
func dormir(milisegundos:entero) -> booleano

# Formatear tiempo con formato personalizado
func formatear(formato:cadena, timestamp:entero) -> cadena

# Parsear string a timestamp
func parsear(fecha:cadena, formato:cadena) -> entero

# Obtener timestamp actual
func timestamp() -> entero

# Sumar tiempo a una fecha
func sumar(timestamp:entero, segundos:entero, minutos:entero, horas:entero, dias:entero, meses:entero, años:entero) -> entero

# Calcular diferencia entre dos timestamps
func diferencia(t1:entero, t2:entero) -> decimal

# Obtener fecha como string
func fecha(timestamp:entero) -> cadena

# Obtener día de la semana (nombre)
func dia_semana(timestamp:entero) -> cadena

# Días en un mes
func dias_mes(año:entero, mes:entero) -> entero

# Verificar si año es bisiesto
func es_bisiesto(año:entero) -> booleano

# Formatear con strftime
func strftime(formato:cadena, timestamp:entero) -> cadena

# Parsear con strptime
func strptime(fecha:cadena, formato:cadena) -> entero

# Cronómetro (segundos desde el inicio)
func cronometro() -> decimal

# Contador de rendimiento (alta precisión)
func contador_perf() -> decimal