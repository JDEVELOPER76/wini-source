importar "os.dll" como os

VERSION_OS = os.variables().OS_VERSION
TEMP = os.variables().TEMP
USUARIO = os.variables().USERNAME
NOMBREPC = os.variables().COMPUTERNAME
PATH_WINI = os.variables("PATH")
EXE_PATH = os.obtener_directorio_exe()
EXE_DIR = os.obtener_ruta_exe()


#funciones desde la dll 

funcion cmd(comando,stdout=verdadero,output=verdadero):
    intentar:
    si stdout:
        retornar os.ejecutar(comando)
    si stdout == falso:
        retornar os.cmd(comando).exit_code
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

    
funcion limpiar_pantalla():
    intentar:
        cmd("cls")
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion ver_variables(nombre):
    intentar:
        si nombre == nulo:
            retornar os.variables(nombre)
        sino nombre:
            retornar os.obtener_variable(nombre).dividir(";")
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion establecer_variable(nombre , valor):
    intentar:
        retornar os.establecer_variable(nombre, valor)
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion ver_archivos(ruta):
    intentar:
        retornar os.listar_archivos(ruta)
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion archivo_existe(ruta):
    intentar:
        si ruta == nulo: 
            retornar falso
        si ruta == "":
            retornar falso
        sino ruta:
            retornar os.archivo_existe(ruta)
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion leer_archivo(ruta):
    intentar: 
        si ruta == nulo o ruta == "":
            retornar falso
        sino ruta:
            retornar os.leer_archivo(ruta)
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"
        
funcion crear_archivo(nombre,contenido=""):
    intentar:
        si os.escribir_archivo(nombre,contenido):
            retornar verdadero
        sino os.escribir_archivo(nombre,contenido) == falso:
            retornar falso
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion escribir_archivo(nombre,contenido=""):
    intentar :
        si os.escribir_archivo(nombre,contenido) == verdadero:
        retornar verdadero
    sino os.escribir_archivo(nombre,contenido) == falso:
        retornar falso
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion agregrar_a_archivo(nombre,contenido):
    intentar:
        si nombre == nulo o nombre == "":
            retornar falso
        sino contenido == nulo:
            retornar falso
        sino nombre y contenido:
            retornar os.agregar_alarchivo(nombre,contenido)

funcion remover_archivo(nombre):
    intentar:
        si nombre == "" o nombre == nulo:
            retornar nulo
        sino nombre:
            retornar cmd(c"del {nombre}")
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion copiar_archivo(origen,destino):
    intentar:
        si origen y destino:
            retornar os.copiar_archivo(origen,destino)
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion mover_archivo(origen,destino):
    intentar:
        si origen y destino:
            retornar os.mover_archivo(origen,destino)
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion info_archivo(ruta):
    intentar:
        si ruta:
            retornar os.info_archivo(ruta)
        demas:
            retornar falso
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

