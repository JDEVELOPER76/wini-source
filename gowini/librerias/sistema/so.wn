funcion esperar(segundos=0):
    intentar:
        si no segundos:
            lanzar (c"'segundos' espera 1 parametro pero recibio 0")
        si tipo(segundos) == "entero" o "decimal":
            os.dormir(segundos*1000)
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

