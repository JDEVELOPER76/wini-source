funcion detener_proceso(pid):
    intentar:
        si tipo(pid) != "entero":
            retornar c"Error: El PID debe ser un número entero."
        sino pid:
            retornar os.matar_proceso(pid)
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

