funcion abrir_url(url):
    intentar:
        si url:
            retornar os.abrir_url(url)
        sino no url:
            lanzar("La funcion espera 1 parametro 'url' pero recibio 0")
    capturar error:
        retornar c"Error al ejecutar la funcion : {error}"

funcion beep(frecuencia,duracion):
